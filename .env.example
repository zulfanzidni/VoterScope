# Environment Variables — VoterScope Demo
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to git.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# Supabase PostgreSQL (Transaction pooler for runtime, session pooler for migrations)
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# SESSION
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET="replace-with-at-least-32-char-random-string"

# ─────────────────────────────────────────────────────────────────────────────
# NIK ENCRYPTION (AES-256-GCM)
# Generate with: openssl rand -hex 32
# ALL IDENTIFIER VALUES ARE SYNTHETIC DEMO DATA.
# ─────────────────────────────────────────────────────────────────────────────
NIK_ENCRYPTION_KEY="replace-with-64-char-hex-string-32-bytes"

# ─────────────────────────────────────────────────────────────────────────────
# NIK HMAC LOOKUP (HMAC-SHA-256)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
NIK_LOOKUP_SECRET="replace-with-64-char-hex-string-32-bytes"

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="VoterScope Demo"
NODE_ENV="development"
